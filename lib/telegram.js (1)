// lib/telegram.js
// دوال الإرسال عن طريق Telegram Bot API مباشرة (من غير polling) عشان تشتغل جوه Vercel.
// فيها حمايات للحمل الكبير: إعادة محاولة تلقائية لو تيليجرام قال "استنى" (429)، وتتبّع اللي حجب البوت،
// وتخزين file_id للملفات (فالملف بيترفع لتيليجرام مرة واحدة بس وبعدها يتبعت لأي حد فورًا).

const crypto = require('crypto');
const redis = require('./redis');

const TELEGRAM_API = `https://api.telegram.org/bot${process.env.TELEGRAM_BOT_TOKEN}`;
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// ---------- Rate Limiter عام ----------
// تيليجرام بيسمح بحوالي 30 رسالة/ثانية للبوت الواحد. لو number كبير من المستخدمين
// ات عالجهم في نفس اللحظة، بننظم الطلبات هنا (token bucket) عشان ما نوصلش لحد
// الـ 429، فالبوت يفضل سريع ومستقر لأي عدد مستخدمين.
const RATE_PER_SEC = parseInt(process.env.TG_RATE_PER_SEC || '25', 10);
const BURST = parseInt(process.env.TG_BURST || '30', 10);
let tokens = BURST;
let lastRefill = Date.now();

async function throttle() {
  while (true) {
    const now = Date.now();
    tokens = Math.min(BURST, tokens + ((now - lastRefill) / 1000) * RATE_PER_SEC);
    lastRefill = now;
    if (tokens >= 1) {
      tokens -= 1;
      return;
    }
    const waitMs = Math.min(((1 - tokens) / RATE_PER_SEC) * 1000, 1000);
    await sleep(waitMs);
  }
}

// الشاتات اللي حجبت البوت (أو اتمسحت) أثناء التشغيل الحالي - الكرون بيوقف الإرسال ليهم
const blockedChats = new Set();
// الأخطاء اللي حصلت أثناء التشغيل الحالي - الكرون بيعمل منها ملخص للمشرفة
let failures = [];

function wasBlocked(chatId) {
  return blockedChats.has(String(chatId));
}
function getFailures() {
  return failures;
}
function resetFailures() {
  failures = [];
}

// لو تنسيق HTML اترفض (مثلاً رمز غريب في نص كتبتيه في الشيت)، بنبعت النص عادي بدل ما الرسالة تضيع
function stripHtml(text) {
  return String(text)
    .replace(/<[^>]+>/g, '')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&');
}

async function callTelegram(method, payload, attempt = 0, quiet = false) {
  await throttle(); // Gate كل طلبات تيليجرام من أي عدد مستخدمين
  let data;
  try {
    const res = await fetch(`${TELEGRAM_API}/${method}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    data = await res.json();
  } catch (err) {
    if (attempt < 2) {
      await sleep(500 * (attempt + 1));
      return callTelegram(method, payload, attempt + 1, quiet);
    }
    if (!quiet) failures.push({ method, description: `network: ${err.message}` });
    return { ok: false, error_code: 0, description: String(err.message) };
  }

  if (data.ok) return data;

  const code = data.error_code;
  const description = data.description || '';

  // تيليجرام بيقول "أبطأ شوية": نستنى المدة اللي طلبها ونعيد المحاولة
  if (code === 429 && attempt < 4) {
    const retryAfter = data.parameters && data.parameters.retry_after;
    await sleep(Math.min(retryAfter === undefined ? 1 : retryAfter, 15) * 1000);
    return callTelegram(method, payload, attempt + 1, quiet);
  }
  // عطل مؤقت من ناحية تيليجرام
  if (code >= 500 && attempt < 2) {
    await sleep(800 * (attempt + 1));
    return callTelegram(method, payload, attempt + 1, quiet);
  }
  // المستخدم حجب البوت أو مسح حسابه
  if (code === 403 || (code === 400 && /chat not found/i.test(description))) {
    if (payload && payload.chat_id !== undefined) blockedChats.add(String(payload.chat_id));
    return data;
  }
  // تنسيق HTML مرفوض: نبعت النص من غير تنسيق
  if (code === 400 && /can't parse entities/i.test(description) && payload.parse_mode === 'HTML') {
    const plain = { ...payload };
    delete plain.parse_mode;
    for (const field of ['text', 'caption']) {
      if (plain[field]) plain[field] = stripHtml(plain[field]);
    }
    return callTelegram(method, plain, attempt + 1, quiet);
  }

  if (!quiet) {
    console.error(`Telegram API error (${method}):`, data);
    failures.push({ method, code, description });
  }
  return data;
}

function sendMessage(chatId, text, extra = {}) {
  return callTelegram('sendMessage', {
    chat_id: chatId,
    text,
    parse_mode: 'HTML',
    ...extra,
  });
}

// رسالة نصية عادية من غير أي تنسيق (للتقارير والتنبيهات)، وبتتقسم لو طويلة
async function sendPlain(chatId, text) {
  for (const chunk of splitText(text, 3800)) {
    await callTelegram('sendMessage', { chat_id: chatId, text: chunk });
  }
}

// تنبيه لصاحبة البوت (ADMIN_CHAT_ID). dedupeKey عشان نفس التنبيه ميتكررش كل لحظة (مرة كل 15 دقيقة).
async function alertAdmin(text, dedupeKey) {
  const admin = process.env.ADMIN_CHAT_ID;
  if (!admin) return;
  try {
    if (dedupeKey) {
      const hash = crypto.createHash('sha1').update(String(dedupeKey)).digest('hex').slice(0, 16);
      const fresh = await redis.setNx(`alert:${hash}`, '1', 900);
      if (!fresh) return;
    }
    await callTelegram('sendMessage', { chat_id: admin, text: String(text).slice(0, 3800) }, 0, true);
  } catch (err) {
    console.error('alertAdmin failed:', err.message);
  }
}

// ---------- الصور والصوت والفيديو (مع تخزين file_id) ----------

const fileKey = (url) =>
  'fid:' + crypto.createHash('sha1').update(String(url)).digest('hex').slice(0, 24);

function extractFileId(method, result) {
  if (!result) return null;
  if (method === 'sendPhoto') {
    return result.photo && result.photo.length ? result.photo[result.photo.length - 1].file_id : null;
  }
  if (method === 'sendAudio') {
    return result.audio ? result.audio.file_id : result.document ? result.document.file_id : null;
  }
  if (method === 'sendVideo') {
    return result.video ? result.video.file_id : result.document ? result.document.file_id : null;
  }
  return null;
}

// أول مرة بنبعت اللينك وتيليجرام بيجيب الملف، وبنحفظ file_id اللي بيرجعه.
// بعد كده أي مستخدم بيستلم الملف بالـ file_id فورًا (من غير ما تيليجرام يروح لـ GitHub تاني).
async function sendMedia(method, field, chatId, url, caption = '') {
  const key = fileKey(url);
  let fileId = null;
  try {
    fileId = await redis.get(key);
  } catch (err) {
    fileId = null;
  }

  if (fileId) {
    const viaId = await callTelegram(
      method,
      { chat_id: chatId, [field]: fileId, caption, parse_mode: 'HTML' },
      0,
      true
    );
    if (viaId.ok || wasBlocked(chatId)) return viaId;
    // الـ file_id ماشتغلش (مثلاً الملف اتغيّر): نرجع للينك
  }

  const res = await callTelegram(method, { chat_id: chatId, [field]: url, caption, parse_mode: 'HTML' });
  if (res.ok) {
    const id = extractFileId(method, res.result);
    if (id) {
      try {
        await redis.pipeline([
          ['SET', key, id],
          ['SADD', 'fids', key],
        ]);
      } catch (err) {
        // مش مشكلة لو الحفظ فشل، هيتبعت باللينك المرة الجاية
      }
    }
  }
  return res;
}

// بيمسح الـ file_id المحفوظين (لو غيّرتي ملف على GitHub بنفس الاسم ومحتاجة المستخدمين يستلموا الجديد)
async function clearFileIdCache() {
  const keys = await redis.smembers('fids');
  if (keys.length > 0) await redis.del(...keys);
  await redis.del('fids');
  return keys.length;
}

function sendPhoto(chatId, photoUrl, caption = '') {
  return sendMedia('sendPhoto', 'photo', chatId, photoUrl, caption);
}

function sendAudio(chatId, audioUrl, caption = '') {
  return sendMedia('sendAudio', 'audio', chatId, audioUrl, caption);
}

function sendVideo(chatId, videoUrl, caption = '') {
  return sendMedia('sendVideo', 'video', chatId, videoUrl, caption);
}

function answerCallbackQuery(callbackQueryId, text) {
  return callTelegram('answerCallbackQuery', {
    callback_query_id: callbackQueryId,
    text,
    show_alert: false,
  });
}

// بيبعت صفحة اليوم كاملة: صورة المصحف + فيديو + صوت + خريطة ذهنية + تفسير
async function sendDailyPage(chatId, content) {
  await sendMessage(
    chatId,
    `📖 <b>صفحة اليوم: ${escapeHtml(content.pageNumber)}</b>\n(${escapeHtml(content.versesRange || '')})`
  );

  if (content.quranPageImageUrl) {
    await sendPhoto(chatId, content.quranPageImageUrl, '📄 نص الصفحة من المصحف');
  }

  if (content.videoUrl) {
    await sendVideo(chatId, content.videoUrl, '🎥 فيديو قراءة الصفحة - د. أيمن سويد');
  }

  if (content.audioUrl) {
    await sendAudio(
      chatId,
      content.audioUrl,
      content.audioUrl2 ? '🎧 ملف صوتي (1/2)' : '🎧 ملف صوتي لتلاوة الصفحة'
    );
  }

  if (content.audioUrl2) {
    await sendAudio(chatId, content.audioUrl2, '🎧 ملف صوتي (2/2)');
  }

  if (content.mindmapImageUrl) {
    await sendPhoto(chatId, content.mindmapImageUrl, '🧠 الخريطة الذهنية للصفحة');
  }

  if (content.tafsirText) {
    // التفسير ممكن يكون طويل (حد تيليجرام 4096 حرف) أو فيه رموز زي & و<، فبنهرّبها ونقسّمه
    const chunks = splitText(content.tafsirText);
    for (let i = 0; i < chunks.length; i++) {
      const prefix = i === 0 ? '📝 <b>التفسير:</b>\n' : '';
      await sendMessage(chatId, prefix + escapeHtml(chunks[i]));
    }
  }
}

// بيبعت سؤال تثبيت بعد صفحة معينة (يوم 2/4/6 من الدورة) - نوعه اختيارات.
// occurrence = ترتيب السؤال بين أسئلة الصفحة، وtotal = عدد أسئلة الصفحة (عشان نكتب "سؤال 2/3").
function sendQuickCheck(chatId, quiz, pageNumber, occurrence = 0, total = 1) {
  const buttons = Object.entries(quiz.options)
    .filter(([, text]) => text)
    .map(([key, text]) => [
      {
        text: `${key}) ${text}`,
        callback_data: `quick:${pageNumber}:${occurrence}:${key}`,
      },
    ]);

  const label = total > 1 ? ` (${occurrence + 1}/${total})` : '';
  return sendMessage(chatId, `🧩 <b>سؤال تثبيت${label}:</b>\n${escapeHtml(quiz.question)}`, {
    reply_markup: { inline_keyboard: buttons },
  });
}

// بيبعت سؤال "إكمال الآية" كزرار تعليم ذاتي بس - المستخدم يسمّع بنفسه من الصوت/الفيديو
// وبعدين يضغط الزرار عشان يأكّد إنه سمّعها، من غير أي تصحيح آلي للنص
function sendSelfCheck(chatId, quiz, callbackData, occurrence = 0, total = 1) {
  const label = total > 1 ? ` (${occurrence + 1}/${total})` : '';
  return sendMessage(chatId, `🎙️${label} ${escapeHtml(quiz.question)}`, {
    reply_markup: {
      inline_keyboard: [[{ text: '✅ سمّعتها', callback_data: callbackData }]],
    },
  });
}

// بيبعت سؤال من ضمن كويز المراجعة الكبير (يوم 7) - نوعه اختيارات. رقم السؤال
// مش محتاج نبعته في الزرار، لأن البوت بيتابعه من شيت التقدم بتاع المستخدم نفسه.
function sendReviewQuestion(chatId, quiz, questionNumber, totalQuestions) {
  const buttons = Object.entries(quiz.options)
    .filter(([, text]) => text)
    .map(([key, text]) => [
      {
        text: `${key}) ${text}`,
        callback_data: `review:${key}`,
      },
    ]);

  return sendMessage(
    chatId,
    `🌟 <b>سؤال المراجعة (${questionNumber}/${totalQuestions}):</b>\n${escapeHtml(quiz.question)}`,
    { reply_markup: { inline_keyboard: buttons } }
  );
}

// نسخة "إكمال الآية" جوه يوم المراجعة الكبير - زرار تعليم ذاتي برضو
function sendReviewSelfCheck(chatId, quiz, questionNumber, totalQuestions) {
  return sendMessage(
    chatId,
    `🌟 <b>سؤال المراجعة (${questionNumber}/${totalQuestions}):</b>\n🎙️ ${escapeHtml(quiz.question)}`,
    {
      reply_markup: {
        inline_keyboard: [[{ text: '✅ سمّعتها', callback_data: 'reviewdone' }]],
      },
    }
  );
}

// بيبعت سؤال من ضمن اختبار محطة (صفحة 21/41/49 مثلاً) - نوعه اختيارات
function sendMilestoneQuestion(chatId, quiz, questionNumber, totalQuestions) {
  const buttons = Object.entries(quiz.options)
    .filter(([, text]) => text)
    .map(([key, text]) => [
      { text: `${key}) ${text}`, callback_data: `milestone:${key}` },
    ]);

  return sendMessage(
    chatId,
    `🏁 <b>سؤال اختبار المحطة (${questionNumber}/${totalQuestions}):</b>\n${escapeHtml(quiz.question)}`,
    { reply_markup: { inline_keyboard: buttons } }
  );
}

// بيبعت رسالة نتيجة اختبار المحطة - مفيهاش أي إيقاف، تشجيع بس والاستمرار عادي
function sendMilestoneResult(chatId, score, total) {
  return sendMessage(
    chatId,
    `🏁 <b>نتيجة اختبار المحطة: ${score} من ${total}</b>\n` +
      'استمر، كل اختبار بيثبّت حفظك أكتر 🌿'
  );
}

// بيبعت رسالة النتيجة + اختيار "تعيد ولا تكمل" لما نتيجة المراجعة تكون أقل من النص
function sendRepeatChoice(chatId, score, total) {
  return sendMessage(
    chatId,
    `📊 <b>نتيجتك في الاختيارات: ${score} من ${total}</b>\n` +
      'عايزة تعيدي نفس الصفحات التلاتة ولا تكمّلي عادي؟',
    {
      reply_markup: {
        inline_keyboard: [
          [{ text: '🔁 أعيد الصفحات', callback_data: 'reviewchoice:repeat' }],
          [{ text: '➡️ أكمّل', callback_data: 'reviewchoice:continue' }],
        ],
      },
    }
  );
}

// نسخة تذكير بس (من غير رقم النتيجة، لأنها بالفعل اتبعتت قبل كده)
function sendRepeatChoiceReminder(chatId) {
  return sendMessage(chatId, '⏰ متنسيش تختاري: تعيدي الصفحات ولا تكمّلي؟', {
    reply_markup: {
      inline_keyboard: [
        [{ text: '🔁 أعيد الصفحات', callback_data: 'reviewchoice:repeat' }],
        [{ text: '➡️ أكمّل', callback_data: 'reviewchoice:continue' }],
      ],
    },
  });
}

// بيبعت نتيجة الإجابة مع التعليق (explanation) اللي مكتوب في الشيت.
// لو الإجابة غلط بيعرض الإجابة الصحيحة كمان. correctTitle اختياري عشان نغيّر عنوان الإجابة الصح.
function sendAnswerFeedback(chatId, quiz, correct, correctTitle) {
  const lines = [correct ? `<b>${escapeHtml(correctTitle || '✅ إجابة صحيحة')}</b>` : '<b>❌ إجابة غير صحيحة</b>'];
  if (!correct && quiz.options && quiz.options[quiz.correct]) {
    lines.push(`الإجابة الصحيحة: ${quiz.correct}) ${escapeHtml(quiz.options[quiz.correct])}`);
  }
  if (quiz.explanation) {
    lines.push('', `💡 ${escapeHtml(quiz.explanation)}`);
  }
  return sendMessage(chatId, lines.join('\n'));
}

// بيبعت رسالة تحفيزية قبل صفحة اليوم الجديدة
function sendMotivation(chatId, text) {
  return sendMessage(chatId, `🌟 ${escapeHtml(text)}`);
}

// ---------- الرسالة المثبتة ----------

// نص بيكتبه المستخدم (إنتِ) من الشيت ممكن فيه < أو & فتكسر تنسيق HTML، فبنهرّبهم
function escapeHtml(text) {
  return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// تيليجرام بيرفض رسالة نصية أطول من 4096 حرف، فبنقسّم النص الطويل على أكتر من رسالة
function splitText(text, maxLen = 4000) {
  const chunks = [];
  let rest = String(text);
  while (rest.length > maxLen) {
    let cut = rest.lastIndexOf('\n', maxLen);
    if (cut < maxLen / 2) cut = maxLen;
    chunks.push(rest.slice(0, cut));
    rest = rest.slice(cut);
  }
  if (rest.trim()) chunks.push(rest);
  return chunks;
}

// بيشوف هل في شات المستخدم رسالة مثبتة بالفعل (عشان منبعتش المثبت أكتر من مرة)
async function hasPinnedMessage(chatId) {
  const res = await callTelegram('getChat', { chat_id: chatId });
  return !!(res && res.ok && res.result && res.result.pinned_message);
}

// بيبعت الرسالة المثبتة (عنوان + زرار لكل قسم) ويثبتها في شات المستخدم مع البوت
async function sendAndPinMenu(chatId, config) {
  const introText = config.introText || 'اختاري من القائمة:';
  const buttons = config.sections.map((section, index) => [
    { text: section.name, callback_data: `info:${index}` },
  ]);

  const sent = await callTelegram('sendMessage', {
    chat_id: chatId,
    text: escapeHtml(introText),
    parse_mode: 'HTML',
    ...(buttons.length ? { reply_markup: { inline_keyboard: buttons } } : {}),
  });

  const messageId = sent && sent.result && sent.result.message_id;
  if (!messageId) return;

  // نشيل أي تثبيت قديم الأول عشان ميتراكمش أكتر من رسالة مثبتة
  await callTelegram('unpinAllChatMessages', { chat_id: chatId });
  await callTelegram('pinChatMessage', {
    chat_id: chatId,
    message_id: messageId,
    disable_notification: true,
  });
}

// تيليجرام بيرفض تعليق (caption) أطول من 1024 حرف تحت صورة/فيديو/صوت،
// فلو التعليق طويل بنبعت الملف من غير تعليق وبعده التعليق كرسالة نصية عادية
const CAPTION_LIMIT = 1000;

async function sendMediaItem(chatId, sender, item) {
  const caption = item.caption || '';
  if (caption.length > CAPTION_LIMIT) {
    await sender(chatId, item.content, '');
    for (const chunk of splitText(caption)) {
      await sendMessage(chatId, escapeHtml(chunk));
    }
  } else {
    await sender(chatId, item.content, caption ? escapeHtml(caption) : '');
  }
}

// بيبعت كل محتوى قسم معين (نصوص / صور / فيديوهات / صوت) بالترتيب
async function sendSectionItems(chatId, items) {
  for (const item of items) {
    if (item.type === 'photo') {
      await sendMediaItem(chatId, sendPhoto, item);
    } else if (item.type === 'video') {
      await sendMediaItem(chatId, sendVideo, item);
    } else if (item.type === 'audio') {
      await sendMediaItem(chatId, sendAudio, item);
    } else {
      for (const chunk of splitText(item.content)) {
        await sendMessage(chatId, escapeHtml(chunk));
      }
    }
  }
}

