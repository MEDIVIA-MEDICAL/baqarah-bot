// api/cron.js
// ده اللي بيشتغل تلقائيًا كل يوم (عن طريق Vercel Cron - متظبط في vercel.json)
// وبيطبّق دورة الـ 7 أيام:
//   يوم 1: صفحة جديدة كاملة
//   يوم 2: سؤال تثبيت على نفس الصفحة
//   يوم 3: صفحة جديدة كاملة (اللي بعدها)
//   يوم 4: سؤال تثبيت
//   يوم 5: صفحة جديدة كاملة
//   يوم 6: سؤال تثبيت
//   يوم 7: مراجعة شاملة على الصفحات التلاتة (كويز مُدمج)
//   يوم 8 (رقم خاص): يوم إعادة مُجمّع للصفحات التلاتة (لما المستخدم يختار "أعيد" بعد نتيجة مراجعة ضعيفة)
//   يوم 9 (رقم خاص): اختبار محطة إضافي (بعد صفحات زي 21/41/49) - بيتحط بعد يوم تثبيت صفحة المحطة
//     مباشرة، وبعد ما يخلص بيرجع الدورة تكمل من نفس اليوم اللي كانت هتيجي لو المحطة مكانتش موجودة.
// لو المستخدم لسه وسط كويز المراجعة أو اختبار المحطة ومجاوبش، الكرون بيفكّره بنفس السؤال بدل ما يبعتله حاجة جديدة.
//
// الحمل الكبير: الكرون بيبعت لكذا مستخدم في نفس الوقت (CRON_CONCURRENCY)، ولو الوقت (حوالي 45 ثانية) خلص
// قبل ما يخلّص الكل، بينده نفسه تاني ويكمّل (chain). كل مستخدم له قفل، وأي مستخدم فشل 3 مرات بنسيبه ونبلّغ المشرفة،
// فمستخدم واحد بايظ مش بيوقّف الباقي. وفي آخر اليوم بتوصل المشرفة رسالة ملخص (لو ماجاتش يبقى فيه مشكلة).

const sheets = require('../lib/sheets');
const telegram = require('../lib/telegram');
const redis = require('../lib/redis');
const { sendNewPageDay, progressAfterNewPage } = require('../lib/daily');

function shuffle(array) {
  const arr = [...array];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// يوم التثبيت: بيبعت كل أسئلة الصفحة (كل سؤال في رسالة)، مش أول سؤال بس.
// بين كل سؤال والتاني انتظار صغير عشان تيليجرام ما يوصلش لحد الـ flood limit.
const QUICK_CHECK_GAP_MS = parseInt(process.env.QUICK_CHECK_GAP_MS || '400', 10);

async function sendQuickCheckDay(user) {
  const quizzes = await sheets.getQuizRowsForPage(user.currentPage);
  if (quizzes.length === 0) {
    await telegram.sendMessage(
      user.chatId,
      `🔁 راجع صفحة ${user.currentPage} تاني كويس النهاردة قبل ما نكمل.`
    );
    return;
  }
  for (let i = 0; i < quizzes.length; i++) {
    const quiz = quizzes[i];
    if (i > 0) await new Promise((r) => setTimeout(r, QUICK_CHECK_GAP_MS));
    if (quiz.type === 'complete') {
      await telegram.sendSelfCheck(
        user.chatId,
        quiz,
        `quickdone:${user.currentPage}:${i}`,
        i,
        quizzes.length
      );
    } else {
      await telegram.sendQuickCheck(user.chatId, quiz, user.currentPage, i, quizzes.length);
    }
  }
}

// بيبدأ يوم المراجعة: بيجمع كل أسئلة الصفحات التلاتة، يخلطها، ويبعت أول سؤال
async function startReviewDay(user) {
  const pages = [user.blockStartPage, user.blockStartPage + 1, user.blockStartPage + 2];
  const allQuizzes = await sheets.getQuizRowsForPages(pages);

  if (allQuizzes.length === 0) {
    // مفيش أسئلة متضافة لسه على الصفحات دي - نعدي المراجعة تلقائيًا
    await telegram.sendMessage(
      user.chatId,
      `🌟 خلصت صفحات ${pages[0]}-${pages[2]}! (مفيش أسئلة مراجعة متضافة لسه، هنكمل عادي).`
    );
    await sheets.updateUserFields(user.telegramId, {
      currentPage: pages[2] + 1,
      blockStartPage: pages[2] + 1,
      cycleDay: 1,
      reviewQueue: [],
      reviewQuestionIndex: 0,
      reviewScore: 0,
    });
    return;
  }

  const queue = shuffle(allQuizzes).map((q) => `${q.pageNumber}:${q.occurrence}`);

  await telegram.sendMessage(
    user.chatId,
    `🌟 <b>يوم المراجعة!</b>\nخلصت صفحات ${pages[0]} - ${pages[2]}. دلوقتي وقت التثبيت 🌿\n` +
      'قبل ما تجاوب، جرّب تسمّع الصفحات التلاتة بصوت عالي من غير مساعدة.'
  );

  await sheets.updateUserFields(user.telegramId, {
    reviewQueue: queue,
    reviewQuestionIndex: 0,
    reviewScore: 0,
  });

  const [firstPage, firstOccurrence] = queue[0].split(':');
  const firstQuiz = await sheets.getQuizByPageOccurrence(firstPage, parseInt(firstOccurrence, 10));
  if (firstQuiz.type === 'complete') {
    await telegram.sendReviewSelfCheck(user.chatId, firstQuiz, 1, queue.length);
  } else {
    await telegram.sendReviewQuestion(user.chatId, firstQuiz, 1, queue.length);
  }
}

// يوم الإعادة المُجمّع (cycle_day = 8): بيبعت الصفحات التلاتة مع بعض في رسايل متتالية،
// وبعدين يقفل البلوك ده ويتحرك للبلوك الجاي - "يشتغل عادي" تاني من بكرة
async function sendCombinedRepeatDay(user) {
  const pages = [user.blockStartPage, user.blockStartPage + 1, user.blockStartPage + 2];

  await telegram.sendMessage(
    user.chatId,
    `🔁 <b>مراجعة مُجمّعة لصفحات ${pages[0]} - ${pages[2]}</b>\nخدي وقتك وسمّعيهم كويس قبل ما نكمل 🌿`
  );

  for (const page of pages) {
    const content = await sheets.getContentForPage(page);
    if (content) {
      await telegram.sendDailyPage(user.chatId, content);
    }
  }

  await sheets.updateUserFields(user.telegramId, {
    currentPage: pages[2] + 1,
    blockStartPage: pages[2] + 1,
    cycleDay: 1,
  });
}

// بيبدأ اختبار محطة (يوم إضافي بعد صفحات معينة زي 21/41/49) - مفيهوش أي إيقاف
// على النتيجة، بس تثبيت إضافي وبعدين يرجع يكمل عادي من حيث كان
async function startMilestoneDay(user) {
  const quizzes = await sheets.getMilestoneQuizRows(user.milestonePage);
  const resumeDay = user.pendingResumeDay || user.cycleDay + 1;

  if (quizzes.length === 0) {
    // مفيش أسئلة متضافة لصفحة المحطة دي لسه - نعدي عادي
    await sheets.updateUserFields(user.telegramId, {
      cycleDay: resumeDay,
      milestonePage: '',
      pendingResumeDay: '',
    });
    return;
  }

  const queue = shuffle(quizzes).map((q) => `${q.occurrence}`);

  await telegram.sendMessage(
    user.chatId,
    `🏁 <b>اختبار محطة! وصلت لصفحة ${user.milestonePage}</b>\n` +
      'ده اختبار تثبيت إضافي بس، مفيش أي إيقاف حتى لو النتيجة مش كويسة 🌿'
  );

  await sheets.updateUserFields(user.telegramId, {
    milestoneQueue: queue,
    milestoneQuestionIndex: 0,
    milestoneScore: 0,
  });

  const firstQuiz = await sheets.getMilestoneQuizByOccurrence(user.milestonePage, parseInt(queue[0], 10));
  await telegram.sendMilestoneQuestion(user.chatId, firstQuiz, 1, queue.length);
}

// لو المستخدم لسه وسط اختبار محطة ومجاوبش، فكّره بنفس السؤال
async function nudgeMilestoneQuestion(user) {
  const occurrence = user.milestoneQueue[user.milestoneQuestionIndex];
  if (occurrence === undefined) return;
  const quiz = await sheets.getMilestoneQuizByOccurrence(user.milestonePage, parseInt(occurrence, 10));
  if (!quiz) return;
  await telegram.sendMessage(user.chatId, '⏰ متنساش تكمل سؤال اختبار المحطة النهاردة:');
  await telegram.sendMilestoneQuestion(
    user.chatId,
    quiz,
    user.milestoneQuestionIndex + 1,
    user.milestoneQueue.length
  );
}

// لو المستخدم لسه في نص كويز المراجعة، فكّره بنفس السؤال بدل ما يستنى لأبد الآبدين
async function nudgeReviewQuestion(user) {
  const currentEntry = user.reviewQueue[user.reviewQuestionIndex];
  if (!currentEntry) return;
  const [page, occurrence] = currentEntry.split(':');
  const quiz = await sheets.getQuizByPageOccurrence(page, parseInt(occurrence, 10));
  if (!quiz) return;
  await telegram.sendMessage(user.chatId, '⏰ متنساش تكمل سؤال المراجعة النهاردة:');
  if (quiz.type === 'complete') {
    await telegram.sendReviewSelfCheck(
      user.chatId,
      quiz,
      user.reviewQuestionIndex + 1,
      user.reviewQueue.length
    );
  } else {
    await telegram.sendReviewQuestion(
      user.chatId,
      quiz,
      user.reviewQuestionIndex + 1,
      user.reviewQueue.length
    );
  }
}

const CONCURRENCY = parseInt(process.env.CRON_CONCURRENCY || '5', 10);
const BUDGET_MS = parseInt(process.env.CRON_BUDGET_MS || '45000', 10);
const TRIGGER_WAIT_MS = parseInt(process.env.CRON_TRIGGER_WAIT_MS || '2500', 10);
const RETRY_WAIT_MS = parseInt(process.env.CRON_RETRY_WAIT_MS || '3000', 10);
const MAX_CHAIN = 60;
const MAX_ATTEMPTS = 3;

// المستخدم وصل لآخر صفحة وخلّص كل حاجة: رسالة ختم مرة واحدة ونوقف الإرسال ليه
async function finishJourney(user, todayStr) {
  await telegram.sendMessage(
    user.chatId,
    '🎉 <b>بارك الله فيك!</b>\nأتممت رحلة حفظ سورة البقرة بحمد الله. نسأل الله أن يثبّت حفظك وأن يعينك على المداومة على مراجعته 🌿\n\n' +
      'لو حابب تبدأ رحلة جديدة من الأول اكتب /restart'
  );
  await sheets.updateUserFields(user.telegramId, { completed: true, lastSentDate: todayStr });
}

// يوم واحد لمستخدم واحد (دورة الـ 7 أيام). بيرجع: sent | finished | nocontent
async function runDay(user, todayStr) {
  const markDone = (extra = {}) =>
    sheets.updateUserFields(user.telegramId, { ...extra, lastSentDate: todayStr });

  // المستخدم لسه وسط كويز مراجعة مجاوبوش خالص
  if (user.reviewQueue.length > 0 && user.reviewQuestionIndex < user.reviewQueue.length) {
    await nudgeReviewQuestion(user);
    await markDone();
    return 'sent';
  }

  // المستخدم لسه وسط اختبار محطة مجاوبوش خالص
  if (user.milestoneQueue.length > 0 && user.milestoneQuestionIndex < user.milestoneQueue.length) {
    await nudgeMilestoneQuestion(user);
    await markDone();
    return 'sent';
  }

  // المستخدم لسه مقررش يعيد ولا يكمل بعد نتيجة مراجعة ضعيفة
  if (user.pendingChoice === 'low_score') {
    await telegram.sendRepeatChoiceReminder(user.chatId);
    await markDone();
    return 'sent';
  }

  const day = user.cycleDay;

  if (day === 9) {
    await startMilestoneDay(user);
    await markDone();
    return 'sent';
  }

  if (day === 8) {
    await sendCombinedRepeatDay(user);
    await markDone();
    return 'sent';
  }

  if (day === 7) {
    await startReviewDay(user);
    await markDone();
    return 'sent';
  }

  const isNewPageDay = day === 1 || day === 3 || day === 5;

  if (isNewPageDay) {
    const sent = await sendNewPageDay(user);
    if (!sent) {
      // مفيش محتوى للصفحة دي: يا إما خلّص السورة، يا إما صفحة ناقصة في الشيت
      if (await sheets.isBeyondLastPage(user.currentPage)) {
        await finishJourney(user, todayStr);
        return 'finished';
      }
      await telegram.alertAdmin(
        `⚠️ صفحة ${user.currentPage} مفيهاش محتوى في تاب Content، وفيه مستخدمين واقفين عندها. ضيفي الصف بتاعها.`,
        `nocontent:${user.currentPage}`
      );
      return 'nocontent';
    }
    // يوم 1 هو أول يوم في البلوك، نسجل بداية البلوك هنا
    await markDone(progressAfterNewPage(user, day));
    return 'sent';
  }

  // يوم تثبيت (2 أو 4 أو 6)
  await sendQuickCheckDay(user);
  const checkedPage = user.currentPage;
  const updates = {};

  // لو الصفحة دي صفحة محطة (زي 21/41/49)، ندخل يوم اختبار إضافي قبل ما نكمل عادي
  const milestoneQuizzes = await sheets.getMilestoneQuizRows(checkedPage);
  if (milestoneQuizzes.length > 0) {
    updates.cycleDay = 9;
    updates.milestonePage = checkedPage;
    updates.pendingResumeDay = day + 1;
  } else {
    updates.cycleDay = day + 1;
  }

  // بعد يوم التثبيت (غير آخر واحد يوم 6) بنتحرك للصفحة الجاية
  if (day === 2 || day === 4) {
    updates.currentPage = user.currentPage + 1;
  }
  await markDone(updates);
  return 'sent';
}

// بيعالج مستخدم واحد بأمان: قفل عليه، وإعادة قراءة حالته، وحد أقصى 3 محاولات فاشلة في اليوم
async function processUser(entry, todayStr) {
  const id = entry.telegramId;
  const lockKey = `lock:u:${id}`;
  const lockToken = await redis.acquireLock(lockKey, 60);
  if (!lockToken) return 'busy'; // المستخدم بيتعامل مع البوت دلوقتي، هنرجعله في الدورة الجاية

  try {
    const user = await sheets.getUserProgress(id);
    if (!user || !user.subscribed || user.completed || user.lastSentDate === todayStr) return 'skip';

    const failKey = `fail:${todayStr}:${id}`;
    const attempts = parseInt((await redis.get(failKey)) || '0', 10);
    if (attempts >= MAX_ATTEMPTS) return 'gaveup';

    let outcome;
    try {
      outcome = await runDay(user, todayStr);
    } catch (err) {
      await redis.pipeline([['INCR', failKey], ['EXPIRE', failKey, 172800]]);
      throw err;
    }

    // لو المستخدم حجب البوت، نوقف الإرسال ليه بدل ما نحاول كل يوم
    if (telegram.wasBlocked(user.chatId)) {
      await sheets.setSubscribed(id, false);
      return 'blocked';
    }
    return outcome;
  } finally {
    await redis.releaseLock(lockKey, lockToken);
  }
}

// بينده الدورة الجاية من نفس الكرون عشان يكمّل باقي المستخدمين
async function triggerNext(req, chain) {
  const host = req.headers['x-forwarded-host'] || req.headers.host;
  const url = `https://${host}/api/cron?chain=${chain}`;
  const headers = process.env.CRON_SECRET ? { authorization: `Bearer ${process.env.CRON_SECRET}` } : {};
  await Promise.race([fetch(url, { headers }).catch(() => {}), redis.sleep(TRIGGER_WAIT_MS)]);
}

// آخر دورة في اليوم: ملخص للمشرفة وتقرير Progress في الشيت (مرة واحدة بس)
async function finalizeDay(todayStr) {
  const claimed = await redis.setNx(`cs:done:${todayStr}`, '1', 172800);
  if (!claimed) return;

  const counts = await redis.hgetall(`cs:${todayStr}`);
  const n = (key) => parseInt(counts[key] || '0', 10);
  const total = n('sent') + n('finished') + n('blocked') + n('gaveup');
  if (total === 0) return;

  const all = await sheets.getAllUsers();
  const active = all.filter((u) => u.subscribed && !u.completed).length;
  await telegram.alertAdmin(
    `📮 ملخص إرسال النهاردة (${todayStr})\n` +
      `✅ وصل: ${n('sent')}\n` +
      `🎉 خلّصوا الرحلة: ${n('finished')}\n` +
      `🚫 حجبوا البوت: ${n('blocked')}\n` +
      `❌ فشل بعد 3 محاولات: ${n('gaveup')}\n` +
      `👥 مشتركين شغّالين: ${active} من ${all.length}`
  );

  try {
    await sheets.exportProgressSnapshot(all);
  } catch (err) {
    console.error('Progress snapshot failed:', err.message);
  }
}

module.exports = async (req, res) => {
  const authHeader = req.headers['authorization'];
  if (process.env.CRON_SECRET && authHeader !== `Bearer ${process.env.CRON_SECRET}`) {
    return res.status(401).send('Unauthorized');
  }

  const started = Date.now();
  const todayStr = new Date().toISOString().slice(0, 10);
  const chain = parseInt((req.query && req.query.chain) || '0', 10) || 0;
  const stats = { sent: 0, finished: 0, blocked: 0, failed: 0, gaveup: 0, nocontent: 0, skip: 0, deferred: 0 };
  telegram.resetFailures();

  try {
    const users = await sheets.getAllSubscribedUsers();
    const pending = users.filter((u) => !u.completed && u.lastSentDate !== todayStr);
    const errors = [];

    let next = 0;
    const worker = async () => {
      while (true) {
        const index = next++;
        if (index >= pending.length) return;
        // الوقت قارب على الخلوص: نسيب الباقي للدورة الجاية
        if (Date.now() - started > BUDGET_MS) {
          stats.deferred += 1;
          continue;
        }
        try {
          const outcome = await processUser(pending[index], todayStr);
          if (outcome === 'busy') stats.deferred += 1;
          else stats[outcome] = (stats[outcome] || 0) + 1;
        } catch (err) {
          stats.failed += 1;
          errors.push(`${pending[index].telegramId}: ${err.message}`);
          console.error('Cron user error:', pending[index].telegramId, err);
        }
      }
    };
    await Promise.all(Array.from({ length: Math.min(CONCURRENCY, pending.length) }, worker));

    // نسجّل الأرقام عشان ملخص آخر اليوم
    const counterCommands = ['sent', 'finished', 'blocked', 'gaveup']
      .filter((k) => stats[k] > 0)
      .map((k) => ['HINCRBY', `cs:${todayStr}`, k, stats[k]]);
    if (counterCommands.length > 0) {
      await redis.pipeline([...counterCommands, ['EXPIRE', `cs:${todayStr}`, 172800]]);
    }

    // أخطاء الإرسال (ملف مش بيتبعت مثلاً): تنبيه واحد مجمّع للمشرفة
    const tgFailures = telegram.getFailures();
    if (tgFailures.length > 0) {
      const sample = tgFailures
        .slice(0, 3)
        .map((f) => `${f.method}: ${f.description}`)
        .join('\n');
      await telegram.alertAdmin(
        `⚠️ حصلت ${tgFailures.length} أخطاء أثناء الإرسال (غالبًا ملف مش بيتبعت أو لينك بايظ). جرّبي /check في البوت.\n${sample}`,
        `tgfail:${todayStr}:${tgFailures[0].description}`
      );
    }
    if (errors.length > 0) {
      await telegram.alertAdmin(
        `⚠️ فشل الإرسال لـ ${errors.length} مستخدم (هتتعاد المحاولة، وبعد 3 مرات بنسيبهم):\n${errors.slice(0, 3).join('\n')}`,
        `cronuser:${todayStr}`
      );
    }

    // لو فاضل مستخدمين مأجلين (الوقت خلص أو مشغولين) أو فشلوا، نكمّل بدورة تانية في نفس اليوم
    if (stats.deferred > 0 || stats.failed > 0) {
      const progressed = stats.sent + stats.finished + stats.blocked + stats.gaveup + stats.skip;
      if (chain < MAX_CHAIN) {
        if (progressed === 0) await redis.sleep(RETRY_WAIT_MS); // كله مشغول أو فاشل، نستنى شوية
        await triggerNext(req, chain + 1);
      } else {
        await telegram.alertAdmin(
          `⚠️ الإرسال اليومي وقف بعد ${MAX_CHAIN} دورة وفاضل ${stats.deferred + stats.failed} مستخدم. افتحي رابط /api/cron تاني.`,
          'chainlimit'
        );
      }
    } else {
      await finalizeDay(todayStr);
    }

    return res.status(200).json({ ok: true, chain, pending: pending.length, ...stats });
  } catch (err) {
    console.error('Cron error:', err);
    await telegram.alertAdmin(`🚨 عطل في الإرسال اليومي: ${err.message}`, `cronerr:${err.message}`);
    return res.status(500).json({ ok: false, error: String(err) });
  }
};
